# Supabase Configuration
# Supabase Dashboard'dan alın: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE_SERVICE_ROLE - SADECE server-side API route'larında kullanılır
# ÖNEMLİ: Bu key'i asla client tarafında kullanmayın!
SUPABASE_SERVICE_ROLE=your-service-role-key-here

# DDL migrations (lab_parameters registry) — Supabase Dashboard → Database → Connection string
# service_role JWT cannot CREATE TABLE; use URI with database password (not committed).
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres

# App Authentication (JWT secret)
# Üretim ortamında güvenli bir random string kullanın
# Örnek: openssl rand -base64 32
APP_JWT_SECRET=change_me_to_a_secure_random_string

# Default Admin Credentials (ilk seed için)
# İlk kurulumda kullanılacak admin kullanıcı bilgileri
APP_DEFAULT_ADMIN=admin
APP_DEFAULT_PASSWORD=admin123
